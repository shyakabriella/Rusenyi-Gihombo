import { api } from "@/lib/api";

import type {
  CreateUserPayload,
  UpdateUserPayload,
  User,
  UserCollectionResponse,
  UserFilters,
  UserStatus,
} from "@/types/user";

function buildQuery(
  filters: UserFilters = {},
) {
  const params =
    new URLSearchParams();

  if (filters.search?.trim()) {
    params.set(
      "search",
      filters.search.trim(),
    );
  }

  if (filters.role) {
    params.set(
      "role",
      filters.role,
    );
  }

  if (filters.status) {
    params.set(
      "status",
      filters.status,
    );
  }

  if (filters.page) {
    params.set(
      "page",
      String(filters.page),
    );
  }

  if (filters.per_page) {
    params.set(
      "per_page",
      String(filters.per_page),
    );
  }

  const query = params.toString();

  return query
    ? `?${query}`
    : "";
}

export async function getUsers(
  filters: UserFilters = {},
): Promise<UserCollectionResponse> {
  const response = await api<{
    success: boolean;
    message: string;
    data: UserCollectionResponse;
  }>(
    `/admin/users${buildQuery(filters)}`,
  );

  return response.data;
}

export async function getUser(
  id: number,
): Promise<User> {
  const response = await api<{
    success: boolean;
    message: string;
    data: User;
  }>(`/admin/users/${id}`);

  return response.data;
}

export async function createUser(
  payload: CreateUserPayload,
): Promise<User> {
  const response = await api<{
    success: boolean;
    message: string;
    data:
      | User
      | {
          user: User;
          email_sent?: boolean;
        };
  }>("/admin/users", {
    method: "POST",
    body: JSON.stringify(payload),
  });

  if (
    "user" in response.data
  ) {
    return response.data.user;
  }

  return response.data;
}

export async function updateUser(
  id: number,
  payload: UpdateUserPayload,
): Promise<User> {
  const response = await api<{
    success: boolean;
    message: string;
    data: User;
  }>(`/admin/users/${id}`, {
    method: "PUT",
    body: JSON.stringify(payload),
  });

  return response.data;
}

export async function updateUserStatus(
  id: number,
  status: UserStatus,
): Promise<User> {
  const response = await api<{
    success: boolean;
    message: string;
    data: User;
  }>(
    `/admin/users/${id}/status`,
    {
      method: "PATCH",
      body: JSON.stringify({
        status,
      }),
    },
  );

  return response.data;
}

export async function resetUserCredentials(
  id: number,
) {
  return api(
    `/admin/users/${id}/reset-credentials`,
    {
      method: "POST",
    },
  );
}

export async function resendUserCredentials(
  id: number,
) {
  return api(
    `/admin/users/${id}/resend-credentials`,
    {
      method: "POST",
    },
  );
}
