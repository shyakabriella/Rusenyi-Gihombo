"use client";

import Link from "next/link";
import { useRouter } from "next/navigation";
import {
  Bell,
  ChevronDown,
  LogOut,
  Menu,
  Search,
  UserRound,
  X,
} from "lucide-react";
import {
  FormEvent,
  useEffect,
  useRef,
  useState,
} from "react";

import { logout } from "@/services/auth-service";

type DashboardTopbarProps = {
  title?: string;
};

export default function DashboardTopbar({
  title,
}: DashboardTopbarProps) {
  const router = useRouter();

  const [profileOpen, setProfileOpen] =
    useState(false);

  const [mobileSearchOpen, setMobileSearchOpen] =
    useState(false);

  const [search, setSearch] =
    useState("");

  const [loggingOut, setLoggingOut] =
    useState(false);

  const profileRef =
    useRef<HTMLDivElement>(null);

  useEffect(() => {
    function handleOutsideClick(
      event: MouseEvent,
    ) {
      if (
        profileRef.current &&
        !profileRef.current.contains(
          event.target as Node,
        )
      ) {
        setProfileOpen(false);
      }
    }

    function handleKeyDown(
      event: KeyboardEvent,
    ) {
      if (event.key === "Escape") {
        setProfileOpen(false);
        setMobileSearchOpen(false);
      }
    }

    document.addEventListener(
      "mousedown",
      handleOutsideClick,
    );

    document.addEventListener(
      "keydown",
      handleKeyDown,
    );

    return () => {
      document.removeEventListener(
        "mousedown",
        handleOutsideClick,
      );

      document.removeEventListener(
        "keydown",
        handleKeyDown,
      );
    };
  }, []);

  function handleSearch(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    const value = search.trim();

    if (!value) {
      return;
    }

    /*
     * Global search results page can be connected
     * when the backend search endpoint is ready.
     *
     * For now we keep the entered search value
     * and the responsive search interface ready.
     */
    console.log("Search:", value);
  }

  async function handleLogout() {
    if (loggingOut) {
      return;
    }

    setLoggingOut(true);

    try {
      await logout();
    } catch (error) {
      console.error(
        "Logout request failed:",
        error,
      );
    } finally {
      setProfileOpen(false);

      router.replace("/login");
      router.refresh();

      setLoggingOut(false);
    }
  }

  return (
    <>
      <header className="relative z-40 flex h-[68px] shrink-0 items-center border-b border-[#ebe4da] bg-white px-4 sm:px-5 lg:px-7">
        <div className="flex min-w-0 flex-1 items-center gap-3 lg:gap-5">
          {/* Mobile sidebar button */}
          <button
            type="button"
            aria-label="Open navigation"
            className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-slate-700 transition hover:bg-[#f8f4ee] lg:hidden"
          >
            <Menu size={23} />
          </button>

          {/* Page title */}
          {title && (
            <h1 className="truncate font-serif text-xl font-semibold text-slate-950 sm:text-2xl">
              {title}
            </h1>
          )}
        </div>

        {/* Desktop search */}
        <form
          onSubmit={handleSearch}
          className="mx-4 hidden w-full max-w-[360px] lg:block"
        >
          <div className="relative">
            <Search
              size={17}
              className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"
            />

            <input
              type="search"
              value={search}
              onChange={(event) =>
                setSearch(event.target.value)
              }
              placeholder="Search..."
              className="h-10 w-full rounded-lg border border-[#e5ded4] bg-[#faf9f7] pl-10 pr-4 text-[13px] text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-[#d4b071] focus:bg-white focus:ring-2 focus:ring-[#d4b071]/15"
            />
          </div>
        </form>

        <div className="flex shrink-0 items-center gap-1.5 sm:gap-3">
          {/* Mobile / tablet search */}
          <button
            type="button"
            onClick={() => {
              setMobileSearchOpen(
                (current) => !current,
              );

              setProfileOpen(false);
            }}
            aria-label="Search"
            className="flex h-10 w-10 items-center justify-center rounded-lg text-slate-700 transition hover:bg-[#f8f4ee] lg:hidden"
          >
            {mobileSearchOpen ? (
              <X size={20} />
            ) : (
              <Search size={20} />
            )}
          </button>

          {/* Notifications */}
          <button
            type="button"
            aria-label="Notifications"
            className="relative flex h-10 w-10 items-center justify-center rounded-lg text-slate-700 transition hover:bg-[#f8f4ee]"
          >
            <Bell size={20} />

            <span className="absolute right-1 top-1 flex h-[17px] min-w-[17px] items-center justify-center rounded-full bg-[#8b5c16] px-1 text-[9px] font-semibold text-white">
              3
            </span>
          </button>

          {/* Profile */}
          <div
            ref={profileRef}
            className="relative"
          >
            <button
              type="button"
              onClick={() => {
                setProfileOpen(
                  (current) => !current,
                );

                setMobileSearchOpen(false);
              }}
              aria-expanded={profileOpen}
              className={[
                "flex items-center gap-2 rounded-xl px-1.5 py-1.5 transition sm:px-2",
                profileOpen
                  ? "bg-[#f7f0e6]"
                  : "hover:bg-[#f8f4ee]",
              ].join(" ")}
            >
              <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#f4e7d2] text-[#0b533a]">
                <UserRound size={20} />
              </div>

              <div className="hidden min-w-0 text-left sm:block">
                <p className="max-w-[125px] truncate text-xs font-semibold text-slate-900">
                  RuHSC Admin
                </p>

                <p className="text-[10px] text-slate-500">
                  Administrator
                </p>
              </div>

              <ChevronDown
                size={15}
                className={[
                  "hidden text-slate-500 transition-transform duration-300 sm:block",
                  profileOpen
                    ? "rotate-180"
                    : "rotate-0",
                ].join(" ")}
              />
            </button>

            {/* Animated dropdown */}
            <div
              className={[
                "absolute right-0 top-[calc(100%+10px)] w-[230px] origin-top-right rounded-xl border border-[#e6ded2] bg-white p-2 shadow-[0_15px_40px_rgba(39,29,18,0.15)] transition-all duration-200",
                profileOpen
                  ? "visible translate-y-0 scale-100 opacity-100"
                  : "invisible -translate-y-2 scale-[0.97] opacity-0",
              ].join(" ")}
            >
              <div className="mb-2 flex items-center gap-3 rounded-lg bg-[#faf7f2] p-3">
                <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#f4e7d2] text-[#0b533a]">
                  <UserRound size={21} />
                </div>

                <div className="min-w-0">
                  <p className="truncate text-sm font-semibold text-slate-900">
                    RuHSC Admin
                  </p>

                  <p className="truncate text-[11px] text-slate-500">
                    Administrator
                  </p>
                </div>
              </div>

              <div className="h-px bg-[#eee8df]" />

              <div className="mt-2 space-y-1">
                <Link
                  href="/dashboard/profile"
                  onClick={() =>
                    setProfileOpen(false)
                  }
                  className="flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium text-slate-700 transition hover:bg-[#f8f4ee] hover:text-[#0b533a]"
                >
                  <UserRound size={17} />

                  My Profile
                </Link>

                <button
                  type="button"
                  disabled={loggingOut}
                  onClick={handleLogout}
                  className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-[13px] font-medium text-red-600 transition hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  <LogOut size={17} />

                  {loggingOut
                    ? "Logging out..."
                    : "Logout"}
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      {/* Mobile search panel */}
      <div
        className={[
          "relative z-30 overflow-hidden border-b border-[#ebe4da] bg-white transition-all duration-300 lg:hidden",
          mobileSearchOpen
            ? "max-h-20 opacity-100"
            : "max-h-0 border-b-0 opacity-0",
        ].join(" ")}
      >
        <form
          onSubmit={handleSearch}
          className="px-4 py-3 sm:px-5"
        >
          <div className="relative">
            <Search
              size={17}
              className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"
            />

            <input
              type="search"
              value={search}
              onChange={(event) =>
                setSearch(event.target.value)
              }
              placeholder="Search..."
              autoFocus={mobileSearchOpen}
              className="h-11 w-full rounded-lg border border-[#e2d8ca] bg-[#faf9f7] pl-10 pr-4 text-sm outline-none transition focus:border-[#d4b071] focus:bg-white focus:ring-2 focus:ring-[#d4b071]/15"
            />
          </div>
        </form>
      </div>
    </>
  );
}
